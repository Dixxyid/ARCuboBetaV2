<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#090d16" />
      <stop offset="100%" stop-color="#1e1b4b" />
    </linearGradient>
    <linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#a855f7" stop-opacity="0.2" />
      <stop offset="50%" stop-color="#ec4899" stop-opacity="1" />
      <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.2" />
    </linearGradient>
    <linearGradient id="sphereGrad" x1="30%" y1="30%" x2="90%" y2="90%">
      <stop offset="0%" stop-color="#818cf8" />
      <stop offset="50%" stop-color="#4f46e5" />
      <stop offset="100%" stop-color="#311042" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="512" height="512" rx="112" fill="url(#bgGrad)" />

  <!-- Back Ring Section -->
  <path d="M 96 280 A 180 65 0 0 1 416 280" fill="none" stroke="url(#ringGrad)" stroke-width="24" stroke-linecap="round" />

  <!-- Planet Sphere -->
  <circle cx="256" cy="256" r="100" fill="url(#sphereGrad)" />

  <!-- Front Ring Section -->
  <path d="M 416 280 A 180 65 0 0 1 96 280" fill="none" stroke="url(#ringGrad)" stroke-width="24" stroke-linecap="round" />
</svg>
